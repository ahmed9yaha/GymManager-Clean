{
  "expo": {
    "name": "GymManager",
    "slug": "GymManager",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "sdkVersion": "52.0.0",
    "owner": "ahmed9yaha",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.ahmed9yaha.gymmanager"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
